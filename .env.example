# Local Docs — server environment (copy to .env)

# HTTP port for the API (Electron dev uses 3847 via process.env override)
PORT=3000

# development | production | test
NODE_ENV=development

# Comma-separated origins allowed for CORS (Vite + API hosts)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Directory where draft documents are stored as {uuid}.json
DOCUMENTS_DIR=./data/documents
